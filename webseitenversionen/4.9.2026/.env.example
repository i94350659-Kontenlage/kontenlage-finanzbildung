# Kontolage – secret-freie Deployment-Vorlage
# Niemals echte Secrets in diese Datei schreiben.
# Browser-sichere Variablen dürfen nur mit VITE_ beginnen und ausschließlich
# Supabase-URL sowie Anon-/Publishable-Key enthalten.
#
# WICHTIG: Diese Vorlage als "webseitenversionen/4.9.2026/.env" kopieren und die
# Werte eintragen (Produktionswerte z. B. via `vercel env pull`). Fehlen
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY beim Build, greift der Guard in
# src/lib/supabase.ts (throw) und der Vite-8/Rolldown-Prod-Build entfernt die
# komplette React-App aus dem Bundle – die Seite bliebe dann leer.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SITE_URL=http://localhost:8443

# Server-only Werte für Supabase Edge Functions.
# Nicht in VITE_*-Variablen und nicht in den Browser-Bundle übernehmen.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_EXECUTIVE=
APP_ORIGIN=http://localhost:8443
APP_ORIGINS=http://localhost:8443,http://localhost:5173
STRIPE_AUTOMATIC_TAX=false

# Nur für die ausdrücklich gewählte Vercel-Legacy-API verwenden.
# Die Zielarchitektur sollte stattdessen Supabase Edge Functions nutzen.
DATABASE_URL=
AUTH_SECRET=

